.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Fetched by `make data` from NBER.
data/raw/

# Regenerated by `make experiments`; kept out so the repo never carries stale
# numbers that disagree with the code.
# reports/*.csv are committed on purpose. They are 28 KB, deterministic, and
# regenerate byte-identically from `make experiments` in about 9 seconds -- but
# the deployed app reads them, and Streamlit Community Cloud only ever sees what
# is in git. Ignoring them shipped an Evidence tab with three empty headings.
.env
.env.local

# Cross-language verification build products. Sources under verify/ are tracked.
verify/peekmc/target/
verify/gocheck/gocheck
